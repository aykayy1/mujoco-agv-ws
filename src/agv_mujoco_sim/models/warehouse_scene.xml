<?xml version="1.0" encoding="utf-8"?>
<mujoco model="industrial_warehouse_40x40">

  <compiler angle="degree" meshdir="../meshes" autolimits="true"/>
  
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
  </visual>

  <statistic center="0 0 0.2" extent="2.0"/>

  <default>
    <joint damping="0.1" armature="0.001"/>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" density="0" group="2"/>
    </default>
    <default class="collision">
      <geom group="3" density="0" friction="1.0 0.005 0.0001" solref="0.005 1" solimp="0.9 0.95 0.001"/>
    </default>
  </default>

  <asset>
    <!-- Assets của Robot (Giữ nguyên gốc) -->
    <mesh name="base_link_mesh" file="base_link.STL"/>
    <mesh name="left_wheel_mesh" file="left_wheel.STL"/>
    <mesh name="right_wheel_mesh" file="right_wheel.STL"/>
    <mesh name="front_left_caster_mesh" file="front_left_caster.STL"/>
    <mesh name="front_right_caster_mesh" file="front_right_caster.STL"/>
    <mesh name="rear_left_caster_mesh" file="rear_left_caster.STL"/>
    <mesh name="rear_right_caster_mesh" file="rear_right_caster.STL"/>
    <mesh name="imu_mesh" file="imu.STL"/>
    <mesh name="lidar_mesh" file="lidar.STL"/>

    <!-- Hệ màu tối giản công nghiệp chuyên nghiệp -->
    <material name="mat_floor"     rgba="0.85 0.86 0.88 1"/> <!-- Sàn Epoxy Xám Sáng -->
    <material name="mat_wall"      rgba="0.25 0.26 0.28 1"/> <!-- Tường Bê tông Xám Đậm -->
    <material name="mat_rack"      rgba="0.15 0.15 0.16 1"/> <!-- Kệ Thép Đen -->
    <material name="mat_pod"       rgba="0.30 0.32 0.35 1"/> <!-- Kệ Kiva Di Động -->
    <material name="mat_conveyor"  rgba="0.65 0.65 0.68 1"/> <!-- Băng chuyền nhôm -->
    <material name="mat_station"   rgba="0.95 0.95 0.95 1"/> <!-- Bàn thao tác Trắng -->
    <material name="mat_pallet"    rgba="0.55 0.45 0.30 1"/> <!-- Pallet Gỗ tự nhiên -->
  </asset>

  <worldbody>
    <light directional="true" pos="0 0 10" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>

    <!-- Mặt sàn 40x40m (half-size = 20) -->
    <geom name="ground_plane" type="plane" size="20 20 0.1" material="mat_floor" friction="1.0 0.005 0.0001"/>

    <!-- Tường bao 40x40m -->
    <body name="boundary_walls">
        <geom name="wall_north" type="box" pos="0 20 1.0"  size="20 0.1 1.0" material="mat_wall"/>
        <geom name="wall_south" type="box" pos="0 -20 1.0" size="20 0.1 1.0" material="mat_wall"/>
        <geom name="wall_east"  type="box" pos="20 0 1.0"  size="0.1 20 1.0" material="mat_wall"/>
        <geom name="wall_west"  type="box" pos="-20 0 1.0" size="0.1 20 1.0" material="mat_wall"/>
    </body>

    <!-- ZONE 1: Pallet Racking (Góc trên trái) - Lối đi tiêu chuẩn 2.8m -->
    <!-- Size box là half-size: width=1.2m (sx=0.6) -->
    <body name="zone_pallet_racks">
        <!-- Dãy trên (length=9m -> sy=4.5) -->
        <geom name="rack_tl_1" type="box" pos="-17 14.5 1.5" size="0.6 4.5 1.5" material="mat_rack"/>
        <geom name="rack_tl_2" type="box" pos="-13 14.5 1.5" size="0.6 4.5 1.5" material="mat_rack"/>
        <geom name="rack_tl_3" type="box" pos="-9 14.5 1.5" size="0.6 4.5 1.5" material="mat_rack"/>
        <geom name="rack_tl_4" type="box" pos="-5 14.5 1.5" size="0.6 4.5 1.5" material="mat_rack"/>
        
        <!-- Dãy dưới (length=7m -> sy=3.5) -->
        <geom name="rack_bl_1" type="box" pos="-17 5.5 1.5" size="0.6 3.5 1.5" material="mat_rack"/>
        <geom name="rack_bl_2" type="box" pos="-13 5.5 1.5" size="0.6 3.5 1.5" material="mat_rack"/>
        <geom name="rack_bl_3" type="box" pos="-9 5.5 1.5" size="0.6 3.5 1.5" material="mat_rack"/>
        <geom name="rack_bl_4" type="box" pos="-5 5.5 1.5" size="0.6 3.5 1.5" material="mat_rack"/>
    </body>

    <!-- ZONE 2: Drive-in & Dead-end Racking (Góc trên phải) - Bẫy Local Planner -->
    <!-- Racks đặt ngang. Width=1.2 (sy=0.6), Length=12 (sx=6.0) -->
    <body name="zone_dead_end_racks">
        <geom name="rack_tr_1" type="box" pos="12 17 1.5" size="6.0 0.6 1.5" material="mat_rack"/>
        <geom name="rack_tr_2" type="box" pos="12 13 1.5" size="6.0 0.6 1.5" material="mat_rack"/>
        <geom name="rack_tr_3" type="box" pos="12 9 1.5"  size="6.0 0.6 1.5" material="mat_rack"/>
        <geom name="rack_tr_4" type="box" pos="12 5 1.5"  size="6.0 0.6 1.5" material="mat_rack"/>

        <!-- Tấm chặn tạo ngõ cụt cho hành lang ở Y=15 và Y=7 (bắt robot phải lùi/quay đầu) -->
        <geom name="deadend_block_1" type="box" pos="18.5 15 1.0" size="0.5 1.4 1.0" material="mat_rack"/>
        <geom name="deadend_block_2" type="box" pos="18.5 7 1.0" size="0.5 1.4 1.0" material="mat_rack"/>
    </body>

    <!-- ZONE 3: Kiva Pod Grid (Góc dưới trái) - Ma trận di chuyển -->
    <!-- Từng cụm Pod 1x1m (sx=0.5, sy=0.5). Bước lưới 3m -->
    <body name="zone_pod_grid">
        <!-- Hàng 1 -->
        <geom name="pod_1_1" type="box" pos="-17 -5 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_1_2" type="box" pos="-14 -5 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_1_3" type="box" pos="-11 -5 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_1_4" type="box" pos="-8 -5 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_1_5" type="box" pos="-5 -5 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <!-- Hàng 2 -->
        <geom name="pod_2_1" type="box" pos="-17 -8 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_2_2" type="box" pos="-14 -8 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_2_3" type="box" pos="-11 -8 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_2_4" type="box" pos="-8 -8 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_2_5" type="box" pos="-5 -8 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <!-- Hàng 3 -->
        <geom name="pod_3_1" type="box" pos="-17 -11 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_3_2" type="box" pos="-14 -11 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_3_3" type="box" pos="-11 -11 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_3_4" type="box" pos="-8 -11 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_3_5" type="box" pos="-5 -11 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <!-- Hàng 4 -->
        <geom name="pod_4_1" type="box" pos="-17 -14 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_4_2" type="box" pos="-14 -14 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_4_3" type="box" pos="-11 -14 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_4_4" type="box" pos="-8 -14 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_4_5" type="box" pos="-5 -14 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <!-- Hàng 5 -->
        <geom name="pod_5_1" type="box" pos="-17 -17 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_5_2" type="box" pos="-14 -17 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_5_3" type="box" pos="-11 -17 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_5_4" type="box" pos="-8 -17 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
        <geom name="pod_5_5" type="box" pos="-5 -17 0.6" size="0.5 0.5 0.6" material="mat_pod"/>
    </body>

    <!-- ZONE 4: Staging & Packing (Góc dưới phải) - Free-space Navigation -->
    <body name="zone_staging">
        <!-- Băng chuyền dài (Conveyor) -->
        <geom name="conveyor_main" type="box" pos="12 -5 0.4" size="6.0 0.6 0.4" material="mat_conveyor"/>
        <!-- Bàn đóng gói (Packing Stations) -->
        <geom name="pack_station_1" type="box" pos="8 -10 0.45" size="1.0 1.5 0.45" material="mat_station"/>
        <geom name="pack_station_2" type="box" pos="16 -10 0.45" size="1.0 1.5 0.45" material="mat_station"/>
        <!-- Pallet đặt lộn xộn (Temporary Obstacles) -->
        <geom name="temp_pallet_1" type="box" pos="12 -15 0.3" size="0.6 0.6 0.3" material="mat_pallet"/>
        <geom name="temp_pallet_2" type="box" pos="7 -17 0.3" euler="0 0 25" size="0.6 0.6 0.3" material="mat_pallet"/>
        <geom name="temp_pallet_3" type="box" pos="17 -16 0.3" euler="0 0 -15" size="0.6 0.6 0.3" material="mat_pallet"/>
    </body>


    <!-- ========================================== -->
    <!-- CẤU TRÚC ROBOT GỐC (Base Link & Sensors) -->
    <!-- ========================================== -->
    <body name="base_link" pos="0 0 0.15">
      <freejoint name="base_freejoint"/>
      <inertial pos="-0.01641684226393 -2.127036027730e-08 0.01536357867772" mass="77.76660059782901" fullinertia="3.2338238997685766 4.5790630022931795 7.535284316709289 6.94917763249993e-07 -0.010447117841865663 -5.34948547228727e-08"/>

      <geom name="base_visual" class="visual" mesh="base_link_mesh" rgba="0.75 0.75 0.75 1"/>
      <geom name="base_collision_rear" class="collision" type="box" pos="-0.322 0 0.015" size="0.100 0.357 0.0725" rgba="0.2 0.5 0.8 0.15"/>
      <geom name="base_collision_center" class="collision" type="box" pos="-0.012 0 0.015" size="0.210 0.250 0.0725" rgba="0.2 0.5 0.8 0.15"/>
      <geom name="base_collision_front" class="collision" type="box" pos="0.298 0 0.015" size="0.100 0.357 0.0725" rgba="0.2 0.5 0.8 0.15"/>

      <site name="base_foot_link" type="sphere" pos="0 0 -0.1" size="0.005" rgba="0 1 0 0"/>

      <body name="left_wheel" pos="0 0.297 0" euler="-90 0 0">
        <joint name="left_wheel_jt" type="hinge" axis="0 0 1" limited="false" damping="0.2"/>
        <inertial pos="-2.2767068983e-06 -4.0883539315e-07 -0.0141278415" mass="0.936684355982048" fullinertia="0.0029343491062 0.0029343328072 0.0056452287041 3.0243843436e-09 1.7611681221e-08 3.1625847890e-09"/>
        <geom name="left_wheel_visual" class="visual" mesh="left_wheel_mesh" rgba="0.15 0.15 0.15 1"/>
        <geom name="left_wheel_collision" class="collision" type="cylinder" size="0.1 0.028" friction="1.2 0.01 0.0001" rgba="1 0 0 0.2"/>
      </body>

      <body name="right_wheel" pos="0 -0.297 0" euler="-90 0 0">
        <joint name="right_wheel_jt" type="hinge" axis="0 0 1" limited="false" damping="0.2"/>
        <inertial pos="2.0712286184e-06 -1.0298315041e-06 0.0141278415" mass="0.936684355982047" fullinertia="0.0029343462033 0.0029343357101 0.0056452287041 -6.9306759880e-09 1.6022183872e-08 -7.9663594389e-09"/>
        <geom name="right_wheel_visual" class="visual" mesh="right_wheel_mesh" rgba="0.15 0.15 0.15 1"/>
        <geom name="right_wheel_collision" class="collision" type="cylinder" size="0.1 0.028" friction="1.2 0.01 0.0001" rgba="1 0 0 0.2"/>
      </body>

      <body name="front_left_caster" pos="0.323 0.167 -0.078807">
        <joint name="front_left_caster_jt" type="ball" damping="0.001"/>
        <inertial pos="0 0 -2.7371825402e-05" mass="0.0399091557703669" fullinertia="7.2111462855e-06 7.2111444698e-06 7.2594199749e-06 8.8035157662e-13 -8.7566291737e-14 2.1607959245e-13"/>
        <geom name="caster_front_left_visual" class="visual" mesh="front_left_caster_mesh" rgba="0.2 0.2 0.2 1"/>
        <geom name="caster_front_left_collision" class="collision" type="sphere" size="0.0212" friction="0.35 0.002 0.0001" rgba="0.1 0.8 0.2 0.25"/>
      </body>

      <body name="front_right_caster" pos="0.323 -0.167 -0.078807">
        <joint name="front_right_caster_jt" type="ball" damping="0.001"/>
        <inertial pos="0 0 -2.7371825402e-05" mass="0.0399091557703669" fullinertia="7.2111462855e-06 7.2111444698e-06 7.2594199749e-06 8.8035157716e-13 -8.7566300715e-14 2.1607958912e-13"/>
        <geom name="caster_front_right_visual" class="visual" mesh="front_right_caster_mesh" rgba="0.2 0.2 0.2 1"/>
        <geom name="caster_front_right_collision" class="collision" type="sphere" size="0.0212" friction="0.35 0.002 0.0001" rgba="0.1 0.8 0.2 0.25"/>
      </body>

      <body name="rear_left_caster" pos="-0.347 0.167 -0.078807">
        <joint name="rear_left_caster_jt" type="ball" damping="0.001"/>
        <inertial pos="0 0 -2.7371825402e-05" mass="0.0399091557703668" fullinertia="7.2111462855e-06 7.2111444698e-06 7.2594199749e-06 8.8035157366e-13 -8.7566301701e-14 2.1607958824e-13"/>
        <geom name="caster_rear_left_visual" class="visual" mesh="rear_left_caster_mesh" rgba="0.2 0.2 0.2 1"/>
        <geom name="caster_rear_left_collision" class="collision" type="sphere" size="0.0212" friction="0.35 0.002 0.0001" rgba="0.1 0.8 0.2 0.25"/>
      </body>

      <body name="rear_right_caster" pos="-0.347 -0.167 -0.078807">
        <joint name="rear_right_caster_jt" type="ball" damping="0.001"/>
        <inertial pos="0 0 -2.7371825402e-05" mass="0.0399091557703668" fullinertia="7.2111459706e-06 7.2111447847e-06 7.2594199749e-06 -1.1169235652e-12 -1.2014432927e-13 -1.9980887354e-13"/>
        <geom name="caster_rear_right_visual" class="visual" mesh="rear_right_caster_mesh" rgba="0.2 0.2 0.2 1"/>
        <geom name="caster_rear_right_collision" class="collision" type="sphere" size="0.0212" friction="0.35 0.002 0.0001" rgba="0.1 0.8 0.2 0.25"/>
      </body>

      <body name="imu" pos="0 0 0.1091">
        <inertial pos="0.0023989165 0 -0.0108251693" mass="0.0350113154456988" fullinertia="4.9486481208e-06 8.8682844667e-06 1.1262903048e-05 2.0030538049e-12 -1.7595997497e-08 6.5460652693e-23"/>
        <geom name="imu_visual" class="visual" mesh="imu_mesh" rgba="0.25 0.25 0.25 1"/>
        <site name="imu_site" type="sphere" pos="0 0 0" size="0.005" rgba="1 0.5 0 0"/>
      </body>

      <body name="lidar" pos="0.33152 0 0.11235">
        <inertial pos="0.0038697684 -1.4554375616e-05 -0.0055496380" mass="0.165382751635991" fullinertia="7.8865183611e-05 7.5190291494e-05 1.0994675306e-04 4.8471764092e-08 2.1847944396e-06 2.8860157251e-08"/>
        <geom name="lidar_visual" class="visual" mesh="lidar_mesh" rgba="0.3 0.3 0.3 1"/>
        <site name="lidar_origin" type="sphere" pos="0 0 0" size="0.005" rgba="1 0 0 0"/>
      </body>
    </body>
  </worldbody>

  <sensor>
    <gyro name="imu_gyro" site="imu_site"/>
    <accelerometer name="imu_accelerometer" site="imu_site"/>
    <framequat name="imu_orientation" objtype="site" objname="imu_site"/>
  </sensor>

  <actuator>
    <velocity name="left_wheel_motor" joint="left_wheel_jt" kv="100" ctrlrange="-8.3775804096 8.3775804096" forcerange="-19.1 19.1"/>
    <velocity name="right_wheel_motor" joint="right_wheel_jt" kv="100" ctrlrange="-8.3775804096 8.3775804096" forcerange="-19.1 19.1"/>
  </actuator>
</mujoco>
